"""m=8 residual witness: the single new denominator direction.
Same construction as check_n6_denmod.py restricted to m=8, printing the
residual (M8, N8) with exact equation assert. M8 expected Fib weight 12.
Run: sage scripts/cas/check_n6_m8wit.sage (stdout log)
"""
from collections import defaultdict


def Q(a, b=1):
    return QQ(a) / b


FIBW6 = (8, 5, 3, 2, 1, 1)
G1 = {(0, 0, 0, 0, 1, 0): Q(1)}
G2 = {(0, 0, 0, 0, 0, 1): Q(1)}
G3 = {(0, 1, 0, 0, 1, 0): Q(2), (0, 0, 2, 0, 0, 0): Q(-1)}
G4 = {(0, 0, 1, 0, 0, 1): Q(2), (0, 0, 0, 2, 0, 0): Q(-1)}
G5 = {(1, 0, 0, 0, 2, 4): Q(105),
      (0, 1, 1, 1, 1, 3): Q(-105),
      (0, 1, 0, 3, 1, 2): Q(35),
      (0, 0, 2, 3, 0, 2): Q(35),
      (0, 0, 1, 5, 0, 1): Q(-21),
      (0, 0, 0, 7, 0, 0): Q(3)}
GENS = [G1, G2, G3, G4, G5]
M_d1 = {(0, 0, 0, 0, 4, 3): QQ(1)}
M_d2 = {(0, 0, 1, 0, 4, 2): QQ(2), (0, 0, 0, 2, 4, 1): QQ(-1)}
M3 = {(0, 0, 0, 4, 2, 1): Q(1),
      (0, 0, 1, 2, 2, 2): Q(-4),
      (0, 0, 2, 0, 2, 3): Q(-16, 21),
      (0, 1, 0, 0, 3, 3): Q(200, 21)}
DRULE = {0: (1, 2), 1: (2, 3), 2: (3, 4), 3: (4, 5)}


def pmul(A, B):
    R = defaultdict(QQ)
    for a, ca in A.items():
        for b, cb in B.items():
            k = tuple(x + y for x, y in zip(a, b))
            R[k] += ca * cb
    return {k: v for k, v in R.items() if v != 0}


def ppow(A, n):
    R = {(0,) * 6: QQ(1)}
    for _ in range(n):
        R = pmul(R, A)
    return R


def padd(A, B, s=1):
    R = defaultdict(QQ, A)
    for k, v in B.items():
        R[k] += s * v
    return {k: v for k, v in R.items() if v != 0}


def D6dict(P):
    R = defaultdict(QQ)
    for m, c in P.items():
        for i, (t1, t2) in DRULE.items():
            if m[i]:
                t = list(m)
                t[i] -= 1
                t[t1] += 1
                t[t2] += 1
                R[tuple(t)] += c * m[i]
    return {k: v for k, v in R.items() if v != 0}


def shift_a1a2(col):
    out = {}
    for e, c in col.items():
        t = list(e)
        t[0] += 1
        t[1] += 1
        out[tuple(t)] = c
    return out


def expand_ge(ge):
    R = {(0,) * 6: QQ(1)}
    for i, e in enumerate(ge):
        if e:
            R = pmul(R, ppow(GENS[i], e))
    return R


def R_tuples(d):
    out = []
    for t in range(d // 7 + 1):
        r0 = d - 7 * t
        for k in range(r0 // 2 + 1):
            for l in range((r0 - 2 * k) // 2 + 1):
                r = r0 - 2 * k - 2 * l
                for i in range(r + 1):
                    out.append((i, r - i, k, l, t))
    return out


def B_tuples(d):
    out = []

    def rec(idx, left, cur):
        if idx == 5:
            out.append(tuple(cur + [left]))
            return
        for e in range(left + 1):
            rec(idx + 1, left - e, cur + [e])
    rec(0, d, [])
    return out


def vecmat(vecs, universe):
    idx = {m: i for i, m in enumerate(universe)}
    M = Matrix(QQ, len(universe), len(vecs), sparse=True)
    for j, V in enumerate(vecs):
        for m, c in V.items():
            M[idx[m], j] = c
    return M


m = 8
Mcols = [shift_a1a2(expand_ge(fe)) for fe in R_tuples(m)]
Bt1 = B_tuples(m + 1)
Ncols = [D6dict({mm: QQ(1)}) for mm in Bt1]
rows = {}
for C in Mcols + Ncols:
    for mm in C:
        if mm not in rows:
            rows[mm] = len(rows)
nM, nN = len(Mcols), len(Ncols)
Mf = Matrix(QQ, len(rows), nM + nN, sparse=True)
for j, C in enumerate(Mcols + Ncols):
    for mm, c in C.items():
        Mf[rows[mm], j] = c
K = Mf.right_kernel()
Mpairs = []
for v in K.basis():
    Mp, Np = {}, {}
    for j in range(nM):
        if v[j] != 0:
            for mm, c in Mcols[j].items():
                Mp[mm] = Mp.get(mm, QQ(0)) + v[j] * c
    for j in range(nN):
        if v[nM + j] != 0:
            mm = Bt1[j]
            Np[mm] = Np.get(mm, QQ(0)) + v[nM + j]
    Mp = {mm: c for mm, c in Mp.items() if c != 0}
    Np = {mm: c for mm, c in Np.items() if c != 0}
    if Mp:
        assert all(mm[0] >= 1 and mm[1] >= 1 for mm in Mp)
        Mu = {(mm[0] - 1, mm[1] - 1) + mm[2:]: c
              for mm, c in Mp.items()}
        Mpairs.append((Mu, Np))
basis, Nbasis = [], []
uni = list({mm for Mu, Np in Mpairs for mm in Mu})
for Mu, Np in Mpairs:
    if vecmat(basis + [Mu], uni).rank() == len(basis) + 1:
        basis.append(Mu)
        Nbasis.append(Np)
print('m=8 M-basis: %d' % len(basis), flush=True)
# generated by the three m=7 dirs via degree-1 K6 monomials
Gvecs = []
for Md in [M_d1, M_d2, M3]:
    for mu in [G1, G2]:
        Gvecs.append(pmul(mu, Md))
uni2 = list({mm for Mu in basis for mm in Mu} |
            {mm for G in Gvecs for mm in G})
print('gendim: %d' % vecmat(Gvecs, uni2).rank(), flush=True)
for Mu, Np in zip(basis, Nbasis):
    if vecmat(Gvecs + [Mu], uni2).rank() == vecmat(Gvecs, uni2).rank():
        continue
    assert padd(shift_a1a2(Mu), D6dict(Np)) == {}, 'eq fault'
    print('residual M8 terms: %d' % len(Mu), flush=True)
    for mm in sorted(Mu):
        print('   %s: %s' % (mm, Mu[mm]), flush=True)
    print('residual N8 terms: %d' % len(Np), flush=True)
    for mm in sorted(Np):
        print('   %s: %s' % (mm, Np[mm]), flush=True)
    wM = {sum(e[i] * FIBW6[i] for i in range(6)) for e in Mu}
    wN = {sum(e[i] * FIBW6[i] for i in range(6)) for e in Np}
    print('Fib M8: %s N8: %s' % (sorted(wM), sorted(wN)), flush=True)
print('m8wit DONE', flush=True)
